# Build — each block builds with its own tool, none of them share a root.
.gradle/
build/
target/          # cargo
.cargo/
cmake-build-*/   # qt / cmake
compile_commands.json

# The index is rebuildable by rescanning: the files are the truth.
data/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Keys never belong in a repository.
.env

.idea/

# Python bytecode and coverage data from the tools.
__pycache__/
*.pyc
.coverage

# Qt et CMake — chaque bloc construit avec son outil.
desktop/build/

# The analyser's own instrumented build, rebuilt by one `cmake`/`ctest`/`gcovr` sequence — not
# part of the tree any more than `desktop/build/` above is.
desktop/coverage/

# Working documents kept beside the code and never published: planning, the
# decisions behind it, assistant instructions, deployment notes written for one
# particular machine. The rule is here before the files are, so that no
# `git add -A` can ever catch them on their way in.
/CLAUDE.md
/AGENTS.md
/docs/
/deploy/
/.superpowers/
/notes/

# Le graphe de connaissance est dérivé du dépôt et se reconstruit d'une commande :
# 5 Mo de JSON et de HTML qui décrivent le code plutôt que d'en faire partie. Ignoré
# ici, avant qu'il existe, pour la même raison que ce qui précède — `git add -A`.
/graphify-out/
